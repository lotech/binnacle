<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.binnacle.logger"
    android:versionCode="3" android:versionName="0.3">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="29" />
    <!-- Only apps signed with the same key (Binnacle itself) may start or stop the logger. Declared
         here and in Binnacle, so it works whichever of the two is installed first. -->
    <permission android:name="app.binnacle.permission.CONTROL_LOGGER" android:protectionLevel="signature" />
    <!-- READ-ONLY: this permission only lets us RECEIVE CAN data. normal protectionLevel. -->
    <uses-permission android:name="app.binnacle.permission.CONTROL_LOGGER" />
    <uses-permission android:name="com.xbs.permission.READ_CAN_DATABASE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- No location permission: the logger never records where the car is. -->
    <application android:label="Binnacle logger" android:icon="@drawable/ic_launcher" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:label="Binnacle logger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Exported only to apps holding CONTROL_LOGGER (same signing key): Binnacle starts it when
             "Start the logger with the dash" is on, since the car's sleep force-stops it. -->
        <service android:name=".CaptureService" android:exported="true"
            android:permission="app.binnacle.permission.CONTROL_LOGGER" />
        <!-- Binnacle asks "are you recording?" so the dash can always show it (same-key apps only). -->
        <receiver android:name=".StateReceiver" android:exported="true"
            android:permission="app.binnacle.permission.CONTROL_LOGGER">
            <intent-filter><action android:name="app.binnacle.logger.QUERY" /></intent-filter>
        </receiver>
    </application>
</manifest>
